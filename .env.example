# Copiar a .env y completar. Nunca commitear el .env real (está en .gitignore).

# Ruta a la base SQLite. Mantener la forma file:./<nombre>.db (Prisma la resuelve
# relativa a prisma/schema.prisma).
DATABASE_URL="file:./prod.db"

# Secreto para firmar las cookies de sesión. Generar con: openssl rand -hex 32
SESSION_SECRET="<openssl rand -hex 32>"

# Usuario para entrar a la webapp. Elegilo vos.
WEBAPP_USERNAME="<tu usuario>"

# Hash bcrypt de la contraseña de la webapp. Generar con:
# node -e "const bcrypt=require('bcrypt'); bcrypt.hash(process.argv[1], 10).then(h => console.log(h))" '<tu contraseña>'
WEBAPP_PASSWORD_HASH="<hash bcrypt>"

# API key de Groq: usada para clasificación, respuestas a consultas y
# transcripción de audios. Sale de https://console.groq.com
GROQ_API_KEY="<tu API key de Groq>"

# Integración con Google Calendar (OPCIONAL): dejá estas 3 líneas comentadas
# (o sin existir) para que los recordatorios funcionen igual pero sin
# sincronizar con Calendar (quedan confirmados directamente, sin loopear
# esperando el evento) — isGoogleCalendarConfigured() solo lo detecta como
# "configurado" cuando GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET tienen un valor
# real, así que una línea descomentada con un placeholder la hace fallar.
# Para activarla, descomentá las 3 líneas y completalas: creá un cliente
# OAuth de tipo "Desktop app" en Google Cloud Console (APIs y servicios →
# Credenciales), con la Calendar API habilitada en el proyecto.
# GOOGLE_CLIENT_ID="<desde Google Cloud Console>"
# GOOGLE_CLIENT_SECRET="<desde Google Cloud Console>"
# GOOGLE_REDIRECT_URI="http://localhost:3000/oauth2callback"

# Moneda por defecto para montos sin moneda explícita. ISO 4217, 3 letras
# mayúsculas. Default (si no se completa): "ARS".
DEFAULT_CURRENCY="ARS"

# Timezone IANA usada para interpretar fechas/horas. Default (si no se
# completa): "America/Argentina/Buenos_Aires".
#
# Limitación conocida: la app usa este único offset UTC fijo (ver
# APP_UTC_OFFSET abajo), sin ajuste de horario de verano/DST. En un timezone
# que observa DST, las horas van a quedar desfasadas una hora durante parte
# del año.
APP_TIMEZONE="America/Argentina/Buenos_Aires"

# Offset UTC fijo (sin horario de verano/DST), formato "+HH:MM" o "-HH:MM".
# Dejá la línea comentada o eliminala para usar el default ("-03:00"); una
# línea presente pero vacía (APP_UTC_OFFSET="") hace fallar el arranque, no
# usa el default — esto importa más corriendo con Docker Compose
# (docker-compose.yml tiene restart: unless-stopped, así que un valor vacío
# ahí entra en crash-loop en vez de fallar una sola vez). Si se completa,
# tiene que tener el formato exacto "+HH:MM"/"-HH:MM" o la app no arranca.
APP_UTC_OFFSET="-03:00"

# Idioma del prompt de clasificación de WhatsApp: "es", "en" o "pt". El resto
# de las respuestas del bot (confirmaciones, respuestas a consultas, avisos
# de recordatorios) sigue siempre en español, sin importar este valor.
# Default (si no se completa): "es".
BOT_LOCALE="es"
